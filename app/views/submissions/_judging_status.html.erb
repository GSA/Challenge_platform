<div data-controller="submission-details">
    <%= form_with(model: @submission, url: submission_path(@submission), class: "maxw-mobile-lg") do |form| %>
        <div class="usa-checkbox">
            <input
            class="usa-checkbox__input usa-checkbox__input--tile"
            id="judging-status-selected"
            type="checkbox"
            name="submission[judging_status]"
            value="selected"
            <%= if @submission.judging_status == "winner" then "disabled" end %>
            <%= if @submission.judging_status.in?(["selected", "winner"]) then "checked" end %>
            data-action="change->submission-details#selectedSubmit"
            />
            <label class="usa-checkbox__label" for="judging-status-selected"
            >This submission is eligible for evaluation.
            <span class="usa-checkbox__label-description"
                >Check the box if the submission is pre-screened and is eligible for the evaluation process.</span
            ></label
            >
        </div>
    <% end %>
    <%= form_with(model: @submission, url: submission_path(@submission), class: "maxw-mobile-lg") do |form| %>
        <div class="usa-checkbox">
            <input
            class="usa-checkbox__input usa-checkbox__input--tile"
            id="judging-status-winner"
            type="checkbox"
            name="submission[judging_status]"
            value="winner"
            <%= unless @submission.judging_status.in?(["selected", "winner"]) then "disabled" end %>
            <%= if @submission.judging_status == "winner" then "checked" end %>
            data-action="change->submission-details#winnerSubmit"
            />
            <label class="usa-checkbox__label" for="judging-status-winner"
            >This submission is selected to advance.
            <span class="usa-checkbox__label-description"
                >Check the box to select this submission to advance or for award after all evaluations are completed.</span
            ></label
            >
        </div>
    <% end %>
    <%= form_with(model: @submission, url: submission_path(@submission), data: {"submission-details-target": "qualifiedForm"}) do |form| %>
        <input
        class="usa-checkbox__input usa-checkbox__input--tile"
        id="judging-status-qualified-hidden"
        type="hidden"
        name="submission[judging_status]"
        value="qualified"
        />
    <% end %>
    <%= form_with(model: @submission, url: submission_path(@submission), data: {"submission-details-target": "selectedForm"}) do |form| %>
        <input
        class="usa-checkbox__input usa-checkbox__input--tile"
        id="judging-status-selected-hidden"
        type="hidden"
        name="submission[judging_status]"
        value="selected"
        />
    <% end %>
</div>    