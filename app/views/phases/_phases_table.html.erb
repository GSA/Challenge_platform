<table aria-label="List of Challenges" class="usa-table usa-table--stacked-header usa-table--borderless challenge-table margin-bottom-10">
    <thead>
      <tr>
        <th scope="col">Challenge</th>
        <th scope="col">Challenge Status</th>
        <th scope="col">Challenge Start and End Dates</th>
        <th scope="col"># of Submissions</th>
        <th scope="col">Evaluation Form</th>
        <th scope="col"># of Evaluators</th>
        <th scope="col">Evaluation Due Date</th>
        <th scope="col">Evaluation Status</th>
      </tr>
    </thead>
    <tbody>
      <% @challenges.each do |challenge| %>
        <% challenge.phases.each do |phase| %>
          <tr>
            <th data-label="Challenge" scope="row" class="text-top">
              <%= link_to "#{Rails.configuration.phx_interop[:phx_uri]}/challenges/#{challenge.id}" do %>
                <strong><%= challenge_phase_title(challenge, phase) %></strong>
              <% end %>  
            </th>
            <td data-label="Challenge Status" class="text-top">
              <%= statuses[challenge.status.to_sym] %>
            </td>
            <td data-label="Challenge Start and End Dates" class="text-top">
              <%= phase.start_date.strftime("%m/%d/%Y") %> <br/>
              <%= phase.end_date.strftime("%m/%d/%Y") %>
            </td>
            <td data-label="# of Submissions" class="text-top">
              <%= submission_count_link(phase, current_user) %>
            </td>
            <td data-label="Evaluation Form" class="text-top">
              <% if phase.evaluation_form %>
                <%= link_to "Edit form", edit_phase_evaluation_form_path(phase, phase.evaluation_form) %>  
              <% else %>
                <%= link_to "Create form", new_phase_evaluation_form_path(phase) %>
              <% end %>  
            </td>
       
            <td data-label="# of Evaluators" class="text-top">
              <%= evaluator_count_or_invite_link(phase, current_user) %>
            </td>
            <td data-label="Evaluation Due Date" class="text-top">
              <%= phase.evaluation_form&.closing_date&.strftime("%m/%d/%Y") %>
            </td>
            <td data-label="Evaluation Status" class="text-top">
              <span class="text-top text-no-wrap usa-tag <%= evaluation_status_color(phase.evaluation_status) %>">
                <%= phase.evaluation_status.to_s.titleize %>
              </span>
            </td>
            </td>  
          </tr>
        <% end %>  
      <% end %>  
    </tbody>
  </table>
  