<% @submissions.each do |submission| %>
  <tr data-controller="submission-judging-status" data-submission-id="<%= submission.id %>" class="border-y-2px border-primary" style="height: 4rem;">
    <th data-label="Submission ID" scope="row">
      <div class="margin-bottom-1 mobile-lg:margin-bottom-3">
        <%= link_to submission_path(submission), class: "text-primary" do %>
          <span class="mobile-lg:display-none">Submission ID </span><%= submission.id %>
        <% end %>
      </div>
    </th>
    <td data-label="Eligible for Evaluation">
      <div class="margin-top-neg-1">
        <div class="display-flex flex-align-center margin-bottom-5 display-none mobile-lg:display-block">
          <div class="usa-checkbox">
            <%= form_with(
                model: submission,
                url: submission_path(submission),
                method: :patch,
                id: "eligibility_form_#{submission.id}",
                data: { 
                  submission_judging_status_target: "eligibilityForm"
                }) do |f| %>
              <fieldset class="usa-fieldset margin-0">
                <legend class="usa-sr-only">Eligibility for evaluation</legend>
                <%= f.check_box :judging_status,
                    id: "eligible_for_evaluation_#{submission.id}",
                    disabled: submission.evaluators_assigned?,
                    checked: submission.eligible_for_evaluation?,
                    class: "usa-checkbox__input",
                    data: {
                      action: "change->submission-judging-status#toggleEligibility",
                      submission_judging_status_target: "eligibilityCheckbox"
                    }
                %>
                <%= f.label :judging_status,
                    "Toggle eligibility for evaluation",
                    for: "eligible_for_evaluation_#{submission.id}",
                    class: "usa-checkbox__label",
                    style: "font-size: 0;" %>
              </fieldset>
            <% end %>
          </div>
        </div>
      </div>        

      <% if submission.eligible_for_evaluation? %>
        <div class="mobile-lg:display-none margin-top-1">
          <span>Yes</span>
        </div>
      <% else  %>
        <div class="mobile-lg:display-none margin-top-1">
          <span>No</span>
        </div>    
      <% end %>
    </td>
    
    <td data-label="Selected to Advance">
      <div class="margin-top-neg-1">    
        <div class="display-flex flex-align-center margin-bottom-5 display-none mobile-lg:display-block">
          <div class="usa-checkbox">
            <%= form_with(
                model: submission,
                url: submission_path(submission),
                method: :patch,
                id: "advancement_form_#{submission.id}",
                data: { 
                  submission_judging_status_target: "advancementForm"
                }) do |f| %>
              <fieldset class="usa-fieldset margin-0">
                <legend class="usa-sr-only">Selected to advance status</legend>
                <%= f.check_box :judging_status,
                    id: "selected_to_advance_#{submission.id}",
                    disabled: submission.evaluations_missing_or_incomplete?,
                    checked: submission.selected_to_advance?,
                    class: "usa-checkbox__input",
                    data: {
                      action: "change->submission-judging-status#toggleAdvancement",
                      submission_judging_status_target: "advancementCheckbox"
                    }
                %>
                <%= f.label :judging_status,
                    "Toggle selected to advance status",
                    for: "selected_to_advance_#{submission.id}",
                    class: "usa-checkbox__label",
                    style: "font-size: 0;" %>
              </fieldset>
            <% end %>
          </div>
        </div>
      </div>

      <% if submission.selected_to_advance? %>
        <div class="mobile-lg:display-none margin-top-1">
          <span>Yes</span>
        </div>
      <% else  %>
        <div class="mobile-lg:display-none margin-top-1">
          <span>No</span>
        </div>    
      <% end %>      
    </td>

    <td data-label="Assigned Evaluators">
      <% active_assignments = submission.evaluator_submission_assignments.select { |a| ['assigned', 'recused'].include?(a.status) } %>
      <% if active_assignments.any? %>
        <div class="display-flex flex-column margin-bottom-2">
          <% active_assignments.each do |assignment| %>
            <div class="margin-bottom-05 display-flex flex-row flex-justify">
              <div class="flex-fill">
                <%= assignment.evaluator.full_name %> - <%= assignment_display_score(assignment) %>
              </div>
              <div class="text-right">
                <span class="usa-tag padding-x-1 text-center width-15 <%= evaluation_status_color(assignment.evaluation_status) %>" style="min-width: 120px; display: inline-block;">
                  <%= assignment.evaluation_status.to_s.titleize %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="margin-bottom-2"
          <span class="font-body-xs text-no-wrap">None yet</span>
        </div>
      <% end %>
    </td>

    <% average_score = average_score(submission).formatted_score %>
    <td data-label="Average Score" data-score="<%= average_score %>">
      <div class="margin-bottom-2">
        <%= average_score %><%= "%" if weighted_scoring?(@phase) && average_score.presence != "-" %>
      </div>
    </td>
  </tr>
<% end %>
