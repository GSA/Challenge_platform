<h1><%= challenge_phase_title(@phase.challenge, @phase) %></h1>
<h2 class="text-bold text-primary">Submissions</h2>

<%= render partial: "submissions_stats" %>
<%= render partial: "submissions_table", locals: { submissions: @submissions } %>

<% if @submissions.empty? %>
  <div class="text-normal display-flex flex-justify-center margin-y-6">
    <p>No submissions found.</p>
  </div>
<% end %>
