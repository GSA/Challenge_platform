<div data-controller="export-submissions" class="padding-top-105 display-none tablet:display-block">
  <nav aria-label="export submissions">
    <ul class="usa-nav__primary usa-accordion">
      <li class="radius-md">
        <button
          type="button"
          class="usa-accordion__button display-flex"
          aria-expanded="false"
          style="background-color: white; border: none; padding: 0;"
          data-action="click->export-submissions#open"
          data-phase-id="<%= @phase.id %>"
          data-challenge-title="<%= @challenge.title %>"
          data-phase-number="<%= phase_number(@challenge, @phase) %>"
        >
          <span class="text-primary text-bold font-sans-md text-underline" style="text-decoration-thickness: 2px;">Export</span>
          <%= image_tag "images/usa-icons/file_download.svg",
              class: "usa-icon icon-down icon-primary-blue",
              style: "width: 18px; height: 18px; margin-top: 4px;",
              alt: "",
              aria: { hidden: true } %>
        </button>
      </li>
    </ul>
  </nav>

  <dialog
    id="export-submissions-modal"
    data-export-submissions-target="modal"
    aria-labelledby="export-modal-heading"
    aria-describedby="export-modal-description"
    class="radius-lg"
  >
    <div class="usa-modal__content maxw-mobile-lg">
      <div class="usa-modal__main display-flex flex-column flex-align-center text-center">
        <h2 class="usa-modal__heading maxw-card-lg margin-x-auto" id="export-modal-heading">
          Please select what data you would like to export.
        </h2>
        <p id="export-modal-description" class="usa-sr-only">
          Select from export submissions options submissions CSV, submission attachments zip, and evaluations CSV.
        </p>        
        <div class="usa-prose margin-y-2 export-checkboxes">
          <fieldset class="usa-fieldset">
            <legend class="usa-sr-only">Export submissions options</legend>     

            <div class="usa-checkbox">
              <input
                class="usa-checkbox__input"
                id="submissions-csv"
                type="checkbox"
                name="export-options"
                value="submissions"
              />
              <label class="usa-checkbox__label padding-2 radius-md border-2px border-base-light width-full" for="submissions-csv">
                Submissions (CSV)
              </label>
            </div>

            <div class="usa-checkbox margin-top-2">
              <input
                class="usa-checkbox__input"
                id="attachments-zip"
                type="checkbox"
                name="export-options"
                value="attachments"
              />
              <label class="usa-checkbox__label padding-2 radius-md border-2px border-base-light width-full" for="attachments-zip">
                Submission attachments (zip)
              </label>
            </div>

            <div class="usa-checkbox margin-top-2">
              <input
                class="usa-checkbox__input"
                id="evaluations-csv"
                type="checkbox"
                name="export-options"
                value="evaluations"
              />
              <label class="usa-checkbox__label padding-2 radius-md border-2px border-base-light width-full" for="evaluations-csv">
                Evaluations (CSV)
              </label>
            </div>
          </fieldset>
        </div>
        <div class="usa-modal__footer">
          <ul class="usa-button-group display-flex flex-column">
            <li class="usa-button-group__item margin-bottom-2">
              <button
                type="button"
                class="usa-button"
                data-action="click->export-submissions#exportSubmissions"
              >
                Export
              </button>
            </li>
            <li class="usa-button-group__item">
              <a
                href="#"
                class="usa-link"
                data-action="click->export-submissions#close">
                Back
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </dialog>
</div>
