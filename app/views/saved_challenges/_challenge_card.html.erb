<li class="usa-card tablet:grid-col-6 desktop:grid-col-3">
  <%= link_to "/challenges/#{challenge_slug(challenge)}", target: "_blank", class: "margin-2 text-no-underline" do %>
    <div class="usa-card__container">
      <div class="usa-card__header">
        <h3 class="usa-card__heading font-sans-lg text-normal"><%= challenge.title %></h3>
      </div>
      <div class="usa-card__media">
        <div class="usa-card__img margin-2 radius-0 bg-white">
          <%= image_tag(
          challenge_logo_url(challenge),
          alt: challenge.logo_alt_text,
          title: "Challenge logo",
          class: "width-full"
          ) %>
        </div>
      </div>
      <div class="usa-card__body"></div>
      <div class="usa-card__footer">
        <%= button_to(
            "Remove",
            saved_challenge_path(challenge.id),
            method: "delete",
            data: [confirm: "Are you sure you want to unsave this challenge?"],
            class: "usa-button usa-button--secondary float-right") %>
      </div>
    </div>
  <% end %>
</li>