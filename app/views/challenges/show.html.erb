<div class="challenge-show-page" data-controller="challenge-detail">
  <div class="radius-lg usa-card usa-card__container margin-y-8">
    <div class="padding-top-4 usa-card__header">
      <div class="usa-grid">
        <div class="grid-row">
          <div class="grid-col-12 tablet:grid-col-6">
            <h1 class="usa-card__heading font-sans-3xl"><%= @challenge.title %></h1>
            <p class="usa-card__tagline font-sans-xl"><%= @challenge.tagline %></p>
            <p class="font-sans-lg"><%= @challenge.brief_description %></p>
          </div>
          <div class="grid-col-12 tablet:grid-col-6">
            <div class="logo-container">
              <% if @logo_url %>
                <% if @challenge.imported && @challenge.sub_status == "archived" && @logo_url.include?("challenge-logo-2_1") %>
                  <%= image_tag @challenge.agency_logo, 
                      alt: "Agency logo for #{@challenge.agency_name}",
                      class: "agency-logo" %>
                <% else %>
                  <%= image_tag @logo_url, 
                      alt: @challenge.logo_alt_text || "Challenge image for \"#{@challenge.title}\"",
                      class: @challenge.upload_logo ? "custom-logo" : "challenge-logo-details-page" %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="usa-card__body bg-gray-warm-5">
      <div class="grid-row grid-gap bg-gray-warm-5">
        <div class="tablet:grid-col-6 grid-col-12">
          <div>
            <div class="grid-row grid-gap padding-top-2">
              <div class="grid-col-12 margin-bottom-2">
                <%= link_to @challenge.how_to_enter_link.start_with?('http') ? @challenge.how_to_enter_link : "https://#{@challenge.how_to_enter_link}", 
                    class: "usa-button usa-button--accent bg-orange-vivid-30v width-full padding-x-4 padding-y-3 tablet:padding-8 radius-lg challenge-apply-button",
                    target: "_blank",
                    rel: "noopener" do %>
                  <span class="text-black font-sans-lg text-no-wrap text-normal">Apply on external website</span>
                <% end %>
              </div>
              <div class="tablet:grid-col-6 grid-col-12 margin-bottom-2 tablet:margin-bottom-0">
                <%= link_to "#", class: "usa-button usa-button--outline width-full padding-x-4 padding-y-2 tablet:padding-4 radius-lg" do %>
                  <%= image_tag('images/usa-icons/bookmark.svg', class: "usa-icon usa-icon--size-3 tablet:usa-icon--size-4 icon-primary-orange", alt: "bookmark") %>
                  <span class="font-sans-lg text-wrap tablet:text-no-wrap text-normal"><%= follow_button_text(@challenge) %></span>
                <% end %>
              </div>
              <div class="tablet:grid-col-6 grid-col-12">
                <%= render partial: "share", locals: { challenge: @challenge } %>
              </div>
            </div>
          </div>
        </div>
        <div class="tablet:grid-col-6 grid-col-12">
          <div class="usa-card usa-card--border-radius">
            <div class="grid-row grid-gap padding-2">
              <div class="grid-col-12 margin-bottom-0 tablet:margin-bottom-2">
                <div class="info-container">
                  <h2 class="text-no-wrap margin-0 margin-right-1 margin-bottom-1">Submission period:</h2>
                  <div class="margin-0">
                    <% submission_data = format_submission_period(@challenge) %>
                    <p class="font-sans-md margin-0 mobile-lg:margin-1"><%= submission_data[:status_text] %></p>
                    <% if submission_data[:closing_soon] %>
                      <p class="date-qualifier">Closing soon</p>
                    <% end %>
                  </div>
                </div>
              </div>
              <div class="grid-col-12 margin-bottom-0 tablet:margin-bottom-2">
                <div class="info-container">
                  <h2 class="text-no-wrap margin-0 margin-right-1 margin-bottom-1">
                    <%= @challenge.types.any? ? "Challenge types:" : "Challenge type:" %>
                  </h2>
                  <p class="font-sans-md margin-0 mobile-lg:margin-1"><%= types_text(@challenge) %></p>
                </div>
              </div>
              <div class="grid-col-12 margin-bottom-2 tablet:margin-bottom-4">
                <div class="info-container">
                  <h2 class="text-no-wrap margin-0 margin-right-1 margin-bottom-1">Total cash prizes:</h2>
                  <p class="font-sans-md margin-0 mobile-lg:margin-1"><%= number_to_currency(@challenge.prize_total / 100) %></p>
                </div>
              </div>
              <div class="grid-col-12">
                <%= link_to "#", class: "usa-link display-flex flex-align-center text-no-wrap", onclick: "window.print(); return false;" do %>
                  <%= image_tag('images/usa-icons/print.svg', class: "usa-icon usa-icon--size-3 margin-right-1 icon-primary-orange", alt: "print") %>
                  <span class="font-sans-md">Print challenge</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <%= render 'challenge_detail_navbar' %>

  <div class="grid-container margin-top-4 challenge-sections-container">
    <div id="overview"  class="challenge-section"><%= render partial: 'overview', locals: { challenge: @challenge } %></div>
    <div id="timeline"  class="challenge-section"><%= render partial: 'timeline', locals: { challenge: @challenge } %></div>
    <div id="prizes"    class="challenge-section"><%= render partial: 'prizes', locals: { challenge: @challenge } %></div>
    <div id="rules"     class="challenge-section"><%= render partial: 'rules', locals: { challenge: @challenge } %></div>
    <div id="judging"   class="challenge-section"><%= render partial: 'judging', locals: { challenge: @challenge } %></div>
    <div id="how_to_enter" class="challenge-section"><%= render partial: 'how_to_enter', locals: { challenge: @challenge } %></div>
    <div id="resources" class="challenge-section"><%= render partial: 'resources', locals: { challenge: @challenge } %></div>
    <div id="faq"       class="challenge-section"><%= render partial: 'faq', locals: { challenge: @challenge } %></div>
    <div id="contact"   class="challenge-section"><%= render partial: 'contact', locals: { challenge: @challenge } %></div>
    <div id="winners"   class="challenge-section"><%= render partial: 'winners', locals: { challenge: @challenge } %></div>
  </div>
</div>





