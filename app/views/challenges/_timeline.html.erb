<div class="usa-card" data-controller="challenge-detail">
  <div class="grid-row border-bottom" style="border-color: #c6cace">
    <div class="grid-col">
      <h2 class="font-sans-xl margin-y-2">Timeline</h2>
    </div>
  </div>

  <div class="usa-card usa-card__container margin-y-6">
    <div class="usa-card-body">
      <div class="timeline-events">
        <% if @challenge.timeline_events.present? %>
          <% sorted_events = @challenge.timeline_events.sort_by { |event| event['date'] } %>
          <% sorted_events.each_with_index do |event, index| %>
            <div class="timeline-event" style="text-align: left; padding: 10px">
              <div>
                <span class="text-bold">
                  <%= format_datetime(DateTime.parse(event['date'])) %>
                </span>: 
                <%= event['title'] %>
              </div>
              <% unless index == sorted_events.length - 1 %>
                <hr style="margin: 5px 0" />
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p>No timeline events available.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

