<table aria-label="List of Challenges" class="usa-table usa-table--stacked-header usa-table--borderless width-full challenge-table margin-bottom-10">
  <thead>
    <tr>
      <th scope="col">Challenge</th>
      <th scope="col"># of Submissions to Evaluate</th>
      <th scope="col">Evaluation Due Date</th>
      <th scope="col">Evaluation Status</th>
    </tr>
  </thead>
  <tbody>
    <% @phases.each do |phase| %>
      <tr>
        <th data-label="Challenge Title" scope="row" class="text-top">
          <%= challenge_phase_title(phase.challenge, phase) %>
        </th>
        <td data-label="# of Submissions to Evaluate" class="text-top">
          <%= link_to submissions_evaluation_path(phase) do %>
            <%= remaining_evaluations_count(current_user, phase.challenge, phase) %> of 
            <%= assigned_submissions_count(current_user, phase.challenge, phase) %> Submissions
          <% end %>
        </td>
        <td data-label="Evaluation Due Date" class="text-top">
          <% if phase.evaluation_form %>
            <%= phase.evaluation_form.closing_date.strftime('%m/%d/%Y') %>
          <% else %>
            N/A
          <% end %>
        </td>
        <td data-label="Evaluation Status" class="text-top">
          <span class="text-top text-no-wrap usa-tag <%= evaluation_status_color(evaluator_evaluation_status(current_user, phase)) %>">
            <%= evaluator_evaluation_status(current_user, phase).to_s.titleize %>
          </span>
        </td> 
      </tr>
    <% end %>
  </tbody>
</table>
