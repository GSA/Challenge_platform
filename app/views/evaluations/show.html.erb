<h1><%= challenge_phase_title(@submission.challenge, @submission.phase) %></h1>
<h2 class="text-primary">Submission ID <%= @submission.id %></h2>

<% if @current_user.non_gov_restricted? %>
  <%= render partial: "evaluations/form" %>
<% else %>
  <%= render partial: "layouts/hotdog", locals: {
    name: 'Submission Materials',
    left: 'evaluations/form',
    right: 'submission_materials/right_panel',
    additional_action: 'submission_materials/open_in_new_tab'
  } %>
<% end %>