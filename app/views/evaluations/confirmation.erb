<div class="padding-bottom-4">
  <% if @subaction == "save_draft" %>
    <h1>Evaluation Draft Saved</h1>
    <p>Your evaluation draft is saved.</p>
    <p>You can edit your scores anytime. Evaluation will not be final and shared with challenge managers until you complete your evaluation.</p>
  <% else %>
    <h1>Evaluation Complete</h1>
    <p>Thank you for completing your evaluation!</p>
    <p>Your evaluation scores are now available for challenge managers to review and determine the winners of their challenge.</p>
  <% end %>
  <%= link_to("Manage Assigned Submissions", submissions_evaluation_path(@evaluation.submission.phase_id), class: "usa-button text-no-wrap") %>
</div>