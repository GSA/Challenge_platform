<div class="usa-table-container--scrollable width-full margin-bottom-10" tabindex="0">
  <table aria-label="List of the Evaluator's Submissions" class="usa-table usa-table--stacked-header usa-table--borderless width-full challenge-table">
    <thead>
      <tr>
        <th scope="col">Submission ID</th>
        <th scope="col" class="text-black">Evaluation Status</th>
        <th scope="col">Score</th>
        <th scope="col" style="text-align: right; padding-right: 3rem;">Action</th>
      </tr>
    </thead>
    <tbody>
      <%= yield %>
    </tbody>
  </table>
</div>