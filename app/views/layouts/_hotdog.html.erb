<%# share evaluation form container for both views %>
<div id="evaluation-form-container">
  <%= render partial: left %>
</div>

<%# burger orientation, for mobile %>
<div class="tablet:display-none" data-controller="hotdog">
    <div data-hotdog-target="burgerCollapsible">
        <%= render partial: right %>
    </div>
    <div class="bg-primary-darker margin-y-1 width-full padding-1">
        <div class="display-flex flex-row flex-justify">
            <div class="display-flex flex-align-center cursor-pointer padding-x-1" data-action="click->hotdog#burgerCollapse" data-hotdog-target="burgerCollapse">
                <%= image_tag('images/usa-icons/arrow_upward.svg', class: "usa-icon--size-3 icon-white margin-bottom-05 margin-right-1", alt: "Hide #{name}") %>
                <span class="text-white width-15 display-inline-block">Hide <%= name %></span>
            </div>
            <div class="display-none display-flex flex-align-center cursor-pointer padding-x-1" data-action="click->hotdog#burgerExpand" data-hotdog-target="burgerExpand">
                <%= image_tag('images/usa-icons/arrow_downward.svg', class: "usa-icon--size-3 icon-white margin-bottom-05 margin-right-1", alt: "Show #{name}") %>
                <span class="text-white width-15 display-inline-block">Show <%= name %></span>
            </div>
            <%= render additional_action if additional_action %>
        </div>
    </div>
    <div id="mobile-evaluation-form"></div>
</div>

<%# hotdog orientation, for tablet and above %>
<div class="display-none tablet:display-flex flex-row width-full border-top-1px" data-controller="hotdog">
    <div class="width-half" data-hotdog-target="leftPane" id="desktop-evaluation-form"></div>
    <div class="bg-primary-darker margin-x-5 width-3 cursor-pointer" data-action="click->hotdog#hotdogCollapse" data-hotdog-target="hotdogCollapse">
        <%= image_tag('images/usa-icons/arrow_forward.svg', class: "usa-icon--size-3 icon-white", alt: "Hide #{name}") %>
    </div>
    <div class="bg-primary-darker margin-left-5 width-3 cursor-pointer display-none" data-action="click->hotdog#hotdogExpand" data-hotdog-target="hotdogExpand">
        <%= image_tag('images/usa-icons/arrow_back.svg', class: "usa-icon--size-3 icon-white", alt: "Show #{name}") %>
    </div>    
    <div class="width-half" data-hotdog-target="rightPane">  
        <%= render partial: right %>
    </div>  
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const evaluationFormContent = document.getElementById('evaluation-form-container');
    const mobileContainer = document.getElementById('mobile-evaluation-form');
    const desktopContainer = document.getElementById('desktop-evaluation-form');

    const container = window.innerWidth >= 640 ? desktopContainer : mobileContainer;
    container.appendChild(evaluationFormContent);
    
    // Move evaluation form on resize
    window.addEventListener('resize', function() {
      const breakpoint = 640;
      const isMobile = window.innerWidth < breakpoint;
      const isDesktop = window.innerWidth >= breakpoint;

      if (isMobile && evaluationFormContent.parentElement === desktopContainer) {
        mobileContainer.appendChild(evaluationFormContent);
      } else if (isDesktop && formContent.parentElement === mobileContainer) {
        desktopContainer.appendChild(evaluationFormContent);
      }
    });
  });
</script>
