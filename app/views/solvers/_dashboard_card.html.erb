<div class="desktop:grid-col-6 margin-y-1">
    <%= link_to(card[:href],
        class: "usa-button display-flex flex-justify-start bg-primary-darker text-white line-height-sans-2 height-card text-no-underline"
        ) do %>
        <%= image_tag(
            "images/usa-icons/#{card[:image_path]}.svg",
            class: "usa-icon--size-7 icon-white margin-x-2",
            alt: ""
        )%>
        <div class="margin-right-2 text-left" >
            <h2><%= card[:title] %></h2>
            <p class="maxw-card-lg font-sans-xs text-normal"><%= card[:subtitle] %></p>
        </div>    
    <% end %>    
</div>