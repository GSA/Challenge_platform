<h2 class="text-primary">Evaluation Form</h2>

<div class="margin-y-4">
  Required fields are marked with an asterisk 
  (<span style="color: darkred;">*</span>).
</div>

<%= form_with(url: url, model: evaluation_form, data: { controller: "evaluation-form modal form-validation" }) do |form| %>
  <%= form_errors_alert(evaluation_form) %>

  <%
    if evaluation_form.challenge && evaluation_form.phase
      challenge = evaluation_form.challenge
      phase = evaluation_form.phase
      combo_box_default_value = "#{challenge.id}.#{phase.id}.#{phase.end_date.strftime("%m/%d/%Y")}"
      disabled = eval_form_disabled?(evaluation_form)
    end
  %>

  <ol class="usa-process-list">
    <li class="usa-process-list__item usa-process-list__item--primary">
      <h3 class="usa-process-list__heading">Evaluation Information</h3>

      <%= form.hidden_field :phase_id, value: @phase.id %>
      <%= form.hidden_field :challenge_id, value: @phase.challenge.id %>

      <div class="usa-form-group">
        <div class="usa-character-count">
          <div class="display-flex flex-align-center text-bold">
            <%= form.label :instructions, "Evaluation Instructions", class: "margin-right-05 #{label_error_class(form, :instructions)}" %>
            <span class="margin-right-05" style="color: darkred;">*</span>
          </div>

          <%= form.text_area :instructions, class: "usa-textarea usa-character-count__field #{input_error_class(form, :instructions)}", maxlength: 3000, rows: "7", data: {"action": "form-validation#validatePresence focusout->form-validation#validatePresence", "field-label": "evaluation instructions"}, disabled: disabled%>
          <span id="with-hint-textarea-info" class="usa-character-count__message">You can enter up to 3000 characters</span>
        </div>

        <%= inline_error(form, :instructions) %>
      </div>

      <div class="usa-form-group">
        <fieldset class="usa-fieldset margin-top-205">
          <legend class="usa-legend usa-process-list__heading display-flex flex-align-center font-sans-md text-bold <%= label_error_class(form, :scale_type) %>">
            <span class="margin-right-05">Scoring Type</span>
            <span class="margin-right-05" style="color: darkred;">*</span>
          </legend>

          <div class="display-flex flex-column maxw-mobile-lg">
            <div class="usa-radio">
              <input
                class="usa-radio__input usa-radio__input--tile"
                id="point_scale"
                type="radio"
                name="evaluation_form[scale_type]"
                value="point"
                data-action="click->evaluation-form#updateMaxPoints form-validation#validatePresence"
                data-field-name="evaluation_form_scale_type"
                <%= 'checked' if evaluation_form.point_scoring? %>
                <%= 'disabled' if disabled %>
              >
              <label class="usa-radio__label font-sans-xs" for="point_scale">Points</label>
            </div>
            <div class="usa-radio">
              <input
                class="usa-radio__input usa-radio__input--tile"
                id="weighted_scale"
                type="radio"
                name="evaluation_form[scale_type]"
                value="weight"
                data-action="click->evaluation-form#updateMaxPoints form-validation#validatePresence"
                data-field-name="evaluation_form_scale_type"
                <%= 'checked' if evaluation_form.weighted_scoring? %>
                <%= 'disabled' if disabled %>
              >
              <label class="usa-radio__label font-sans-xs" for="weighted_scale">Weights (%)</label>
            </div>
          </div>

          <div class="margin-top-1">
            <%= inline_error(form, :scale_type) %>
          </div>

          <div class="display-flex flex-align-center text-bold margin-top-3 maxw-mobile-lg">
            <div class="usa-checkbox ">
              <%= form.check_box :comments_required, class: "usa-checkbox__input usa-checkbox__input--tile", id: "evaluation_form_comments_required", disabled: disabled %>
              <%= form.label :comments_required, class: "usa-checkbox__label" do %>
                <span class="text-bold">Require score comments (optional)</span>
                <span class="usa-checkbox__label-description">Check the box if the evaluators are required to provide comments on their scores.</span>
              <% end %>
            </div>
          </div>
        </fieldset>
      </div>
    </li>

    <li class="usa-process-list__item usa-process-list__item--primary">
      <h3 class="usa-process-list__heading">Evaluation Criteria</h3>

      <div data-controller="evaluation-criteria">
        <div id="criteria-list" class="margin-top-4 usa-accordion usa-accordion__multiselectable" data-allow-multiple data-evaluation-criteria-target="criteriaList">
          <% if evaluation_form.evaluation_criteria.empty? %>
            <%= form.fields_for :evaluation_criteria, EvaluationCriterion.new do |ec| %>
              <div class="criteria-row margin-bottom-2" data-evaluation-criteria-target="criteriaRow" data-index="0">
                <%= render partial: 'evaluation_criterion_fields', locals: { f: ec, is_template: false, form_disabled: false } %>
              </div>
            <% end %>
          <% else %>
            <%= form.fields_for :evaluation_criteria, include_id: false do |ec| %>
              <div class="criteria-row margin-bottom-2" style="<%= ec.object.marked_for_destruction? ? "display: none;" : "" %>" data-evaluation-criteria-target="criteriaRow" data-index="<%= ec.options[:child_index] %>">
                <%= render partial: 'evaluation_criterion_fields', locals: { f: ec, is_template: false, form_disabled: disabled } %>
              </div>
            <% end %>
          <% end %>
        </div>

        <% if !disabled %>
          <div class="usa-accordion">
            <div id="criteria-template" class="criteria-row margin-bottom-2 display-none" data-evaluation-criteria-target="template" data-index="template">
              <%= form.fields_for :evaluation_criteria, EvaluationCriterion.new do |ec| %>
                <%= render partial: 'evaluation_criterion_fields', locals: { f: ec, is_template: true, form_disabled: disabled } %>
              <% end %>
            </div>
          </div>
        
          <%= button_tag type: "button", id: "add-criteria-button", class: "usa-button usa-button--outline", title: "Add another criteria", data: {action: "click->evaluation-criteria#addCriteria"} do %>
            <div class="font-sans-xs">Add another criteria</div>
          <% end %>
        <% end %>
      </div>
    </li>

    <li class="usa-process-list__item usa-process-list__item--primary">
      <h3 class="usa-process-list__heading">Evaluation Period</h3>
      <div class="usa-label text-bold font-sans-sm">Evaluation Start Date</div>
      <div class="usa-hint"><%= @phase.end_date.strftime('%m/%d/%Y') %></div>

      <div class="usa-form-group">
        <div class="display-flex flex-align-center text-bold">
          <%= form.label :closing_date, "Evaluation End Date", class: "margin-right-05 #{label_error_class(form, :closing_date)}" %>
          <span style="color: darkred;">*</span>
        </div>
        <div class="usa-hint" id="evaluation_form_closing_date_hint">mm/dd/yyyy</div>

        <div data-evaluation-form-target="datePicker" class="usa-date-picker" data-default-value="<%= evaluation_form.closing_date %>" data-min-date="<%= @phase.end_date %>">
          <input
            class="usa-input <%= input_error_class(form, :closing_date) %>"
            id="evaluation_form_closing_date"
            name="evaluation_form[closing_date]"
            aria-labelledby="evaluation_form_closing_date"
            aria-describedby="evaluation_form_closing_date_hint"
            data-action="form-validation#validatePresence focusout->form-validation#validatePresence"
            data-field-label="closing date"
          />
        </div>

        <%= inline_error(form, :closing_date) %>
      </div>
    </li>

    <li class="padding-left-5">
      <div class="display-flex flex-wrap margin-bottom-2">
        <button type="submit" name="commit" class="usa-button width-auto text-no-wrap">
            <%= image_tag('images/usa-icons/check.svg', class: "usa-icon icon-white", alt: "save") %>
            Save Form
        </button>
        <div class="text-center width-auto margin-y-1 margin-x-3">
          <%= link_to "Cancel", "#", data: {"action": "modal#open", "modal-target-id": "cancel"} %>
        </div>
      </div>
    </li>
  </ol>

  <%= render "modals/confirmation", 
    id: "cancel",
    heading: "Are you sure you want to cancel?",
    description: "Your evaluation form will not be saved and any entered information will be lost.",
    confirm_text: "Yes",
    cancel_text: "Close",
    confirm_redirect: phases_path
  %>

  <%= render "modals/confirmation", 
    id: "remove-criteria",
    heading: "Are you sure you want to remove this criteria?",
    description: "",
    confirm_text: "Yes",
    cancel_text: "No",
    confirm_action: "evaluation-criteria#removeCriteria"
  %>
<% end %>
