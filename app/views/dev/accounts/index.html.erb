<div class="grid-container">
  <div>
    <h1>By Email</h1>
    <%= form_with url: "/dev/login" do |form| %>
      <%= form.label :email %>
      <%= form.text_field :email %>
      <%= form.submit "Dev Login" %>
    <% end %>
